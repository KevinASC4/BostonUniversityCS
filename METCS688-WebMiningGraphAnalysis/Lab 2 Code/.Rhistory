set.seed(1)
population <- rexp(100000, rate = 1)
hist(population, probability = TRUE, main = "Exponential Distribution", xlab = "Value")
lines(density(population), col = "blue", lwd = 2)
# b. Population stats
mean(population)  # ≈ 1
var(population)   # ≈ 1
# d. Sampling
sample_sizes <- c(5, 30, 100)
sample_means_list <- lapply(sample_sizes, function(n) {
replicate(10000, mean(sample(population, size = n)))
})
# e. Plotting standard normal overlay
par(mfrow = c(1, 3))
for (i in 1:3) {
n <- sample_sizes[i]
sm <- sample_means_list[[i]]
standardized <- (sm - mean(population)) / (sqrt(var(population)/n))
hist(standardized, probability = TRUE, main = paste("n =", n),
xlab = "Standardized Sample Mean", ylim = c(0, 0.5))
curve(dnorm(x), add = TRUE, col = "red", lwd = 2)
}
