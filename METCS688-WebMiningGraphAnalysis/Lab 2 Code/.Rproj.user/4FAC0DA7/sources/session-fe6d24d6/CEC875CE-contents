set.seed(1)
n <- 20
m <- 100 
X <-matrix(rnorm(n * m), ncol = m) 

pvals <- apply(X, 2, function(x) t.test(x, mu = 0)$p.value)
hist(pvals, breaks = 20, col = "skyblue", main = "Histogram of p-values", xlab = "p-value")

sum(pvals <= 0.05)


sum(p.adjust(pvals, method = "bonferroni") <= 0.05)

sum(p.adjust(pvals, method = "holm") <= 0.05)


